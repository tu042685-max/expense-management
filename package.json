{
  "name": "splitflow",
  "version": "1.0.0",
  "description": "Full-stack group expense sharing application",
  "private": true,
  "scripts": {
    "dev:all": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client/Expense-management && npm run dev",
    "build": "npm run build:server && npm run build:client",
    "build:server": "cd server && npm run build",
    "build:client": "cd client/Expense-management && npm run build",
    "install:all": "npm install && cd server && npm install && cd ../client/Expense-management && npm install",
    "setup": "bash setup.sh",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
